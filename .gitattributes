# Normalize to LF in the repository; check out native on Windows.
* text=auto

*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.sh    text eol=lf

*.png   binary
*.jpg   binary
*.ico   binary
*.svg   text eol=lf
