# Neon pooled connection string (the one ending in -pooler).
# Serverless functions open a connection per invocation, so the pooled
# endpoint is what keeps Neon's connection limit from being the ceiling.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/deploylens?sslmode=require

# GitHub OAuth App credentials (Settings > Developer settings > OAuth Apps).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Shared secret configured on the GitHub webhook; every delivery is verified
# against it before the payload is trusted.
GITHUB_WEBHOOK_SECRET=

# Signs session cookies. 32+ random bytes.
SESSION_SECRET=

# Fernet key encrypting stored GitHub access tokens at rest.
TOKEN_ENCRYPTION_KEY=

# Guards the scheduled health-check endpoint so only the scheduler can run it.
CRON_SECRET=

# Public origin, used for OAuth redirects and cookie scope.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
